import com.opencsv.exceptions.CsvException;

import java.io.IOException;
import java.util.List;

public class CsvToJsonProcessor {

    private final CsvReaderService csvReaderService;
    private final JsonPopulatorService jsonPopulatorService;

    public CsvToJsonProcessor() {
        this.csvReaderService = new CsvReaderService();
        this.jsonPopulatorService = new JsonPopulatorService();
    }

    public void processCsvToJson(String csvFilePath, String outputDirectory) throws IOException, CsvException {
        // Read CSV file
        List<String[]> csvRecords = csvReaderService.readCsv(csvFilePath);

        // Populate JSON from CSV records and write to files
        jsonPopulatorService.populateJsonFromCsvAndWriteToFile(csvRecords, outputDirectory);
    }
}


